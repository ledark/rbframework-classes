{
    "name": "ledark/rbframeworks",
    "type": "library",
    "description": "Utilitarios para RBFrameworks",
    "keywords": [
        "rbframeworks"
    ],
    "homepage": "https://github.com/ledark/rbframework-classes",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricardo Bermejo",
            "email": "mestreledark@gmail.com",
            "homepage": "http://bermejo.com.br",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Framework\\": [
                "src/v1/"
            ],
            "RBFrameworks\\": [
                "src/v3/",
                "src/v2/"
            ],
            "RBFrameworks\\Core\\": [
                "src/v3/",
                "src/v2/"
            ],
            "Tests\\": "tests/"
        }
    },
    "files": [
        "_include.php"
    ],
    "config": {
        "vendor-dir": "vendor/",
        "platform": {
            "php": "8.5.0"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "require": {
        "guzzlehttp/guzzle": "^7.10",
        "bramus/router": "^1.6",
        "symfony/cache": "^7.2",
        "sergeytsalkov/meekrodb": "^2.2",
        "eftec/bladeone": "^3.44",
        "eftec/bladeonehtml": "^1.4",
        "phpmailer/phpmailer": "^6.8"
    }
}
